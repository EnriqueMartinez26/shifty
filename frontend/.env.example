VITE_API_URL=https://api.example.com

# Contacto de Shifty (banner de renovacion y /legal/*). Solo placeholders: los
# valores reales van como variables del repo en GitHub, que CI pasa como build
# args (el repo es publico). Vacio = el front omite esa linea.
# WhatsApp de soporte: solo digitos con codigo de pais, p. ej. 549351XXXXXXX.
VITE_SUPPORT_WHATSAPP=
# Email de contacto, p. ej. contacto@example.com.
VITE_CONTACT_EMAIL=
# Responsables (Ley 25.326 art. 6): uno o mas nombres completos, texto libre.
VITE_LEGAL_RESPONSABLES=

