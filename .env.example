# Database
POSTGRES_USER=shifty_user
POSTGRES_PASSWORD=shifty_password
POSTGRES_DB=shifty_db

# App Settings
SECRET_KEY=generate_a_very_secret_key_here_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# URLs
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-example-pooler.us-east-1.aws.neon.tech/shifty?ssl=require
REDIS_URL=rediss://default:PASSWORD@global-redis.upstash.io:6379
FRONTEND_URL=https://app.example.com
PUBLIC_API_URL=https://api.example.com
CORS_ORIGINS=https://app.example.com
CRON_SECRET=change_me
VERCEL_QUEUE_REGION=

# Email (Mock for now)
SMTP_HOST=placeholder
SMTP_PORT=587
SMTP_USER=placeholder
SMTP_PASS=placeholder
EMAILS_FROM_EMAIL=no-reply@shifty.app

# Environment
ENV=production
RUN_RUNTIME_CONTRACTS_ON_STARTUP=false
COOKIE_SECURE=true
COOKIE_SAMESITE=none
EXPOSE_API_DOCS=false
ALLOW_PUBLIC_REGISTRATION=false
RATE_LIMIT_ENABLED=true
FIELD_ENCRYPTION_KEY=change_this_to_a_32_char_minimum_secret
