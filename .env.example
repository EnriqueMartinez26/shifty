# Database
POSTGRES_USER=shifty_user
POSTGRES_PASSWORD=shifty_password
POSTGRES_DB=shifty_db

# App Settings
SECRET_KEY=generate_a_very_secret_key_here_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# URLs
DATABASE_URL=postgresql+asyncpg://shifty_user:shifty_password@db:5432/shifty_db
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# Email (Mock for now)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
EMAILS_FROM_EMAIL=no-reply@shifty.app

# Environment
ENV=development
