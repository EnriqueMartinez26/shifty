# Database
POSTGRES_USER=shifty_user
POSTGRES_PASSWORD=shifty_password
POSTGRES_DB=shifty_db

# App Settings
SECRET_KEY=generate_a_very_secret_key_here_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# URLs
DATABASE_URL=postgresql+asyncpg://shifty_user:shifty_password@localhost:5432/shifty_db
REDIS_URL=redis://localhost:6379/0
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CRON_SECRET=change_me

# Optional local worker stack. docker-compose overrides these for RabbitMQ.
RABBITMQ_DEFAULT_USER=shifty
RABBITMQ_DEFAULT_PASS=shifty_password
CELERY_BROKER_URL=amqp://shifty:shifty_password@rabbitmq:5672//
CELERY_RESULT_BACKEND_URL=redis://redis:6379/1

# Email (Mock for now)
SMTP_HOST=placeholder
SMTP_PORT=587
SMTP_USER=placeholder
SMTP_PASS=placeholder
EMAILS_FROM_EMAIL=no-reply@shifty.app

# Environment
ENV=production
RUN_RUNTIME_CONTRACTS_ON_STARTUP=false
COOKIE_SECURE=true
COOKIE_SAMESITE=none
EXPOSE_API_DOCS=false
ALLOW_PUBLIC_REGISTRATION=false
RATE_LIMIT_ENABLED=true
FIELD_ENCRYPTION_KEY=change_this_to_a_32_char_minimum_secret
