# Database
POSTGRES_USER=shifty_user
# Rol DUENO de la base: tiene DDL y RLS no lo alcanza, asi que es la
# credencial mas sensible del stack. Sin default: el compose no levanta si
# falta. Generala con `openssl rand -hex 32` (AUD2-C-02).
POSTGRES_PASSWORD=
POSTGRES_DB=shifty_db
# Contrasena del rol `shifty_app` (sin superusuario ni BYPASSRLS) con el que
# conecta la app. OBLIGATORIA y sin default: la migracion que crea el rol y
# docker-compose fallan si falta. Generala con `openssl rand -hex 32`. Si tu
# base local ya tiene el rol creado, pone la contrasena con la que se creo o
# rotala con `ALTER ROLE shifty_app PASSWORD '...'`.
APP_DB_PASSWORD=

# App Settings
# OBLIGATORIO y sin default: generar con `openssl rand -hex 32`.
# Fuera de development el arranque rechaza este placeholder o claves <32 chars.
SECRET_KEY=
FIELD_ENCRYPTION_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# URLs
# `ssl` es el parametro de asyncpg (`sslmode=` en esta URL rompe la API). Las
# migraciones (run_migrations.py, alembic) exigen TLS si la URL no dice nada;
# el Postgres local no tiene TLS, por eso `ssl=disable` explicito (B7-11).
DATABASE_URL=postgresql+asyncpg://shifty_user:PONE_ACA_POSTGRES_PASSWORD@localhost:5432/shifty_db?ssl=disable
# TLS de las URLs de docker-compose.yml (x-app-environment). Default `disable`:
# el `db` del compose no tiene TLS. `require` SOLO si esa base tiene TLS
# configurado; con otro valor la API y las migraciones no conectan.
POSTGRES_SSL=disable
# Dos Redis (F0-15): estado en 6379 (noeviction) y cache de disponibilidad en
# 6380 (volatile-ttl). Sin REDIS_CACHE_URL el cache usa REDIS_URL.
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6380/0
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
VITE_API_URL=/api
CRON_SECRET=change_me
# Sentry backend (API + workers). Vacio = desactivado.
SENTRY_DSN=

VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Optional local worker stack. docker-compose overrides these for RabbitMQ.
RABBITMQ_DEFAULT_USER=shifty
# Sin default, igual que las otras credenciales: `openssl rand -hex 32`.
RABBITMQ_DEFAULT_PASS=
CELERY_BROKER_URL=amqp://shifty:PONE_ACA_RABBITMQ_DEFAULT_PASS@rabbitmq:5672//
CELERY_RESULT_BACKEND_URL=redis://redis_state:6379/1

# Email (Mock for now)
SMTP_HOST=placeholder
SMTP_PORT=587
SMTP_USER=placeholder
SMTP_PASS=placeholder
EMAILS_FROM_EMAIL=no-reply@shifty.app

# Tag de las imagenes del compose (F0-02). En desarrollo queda en `dev`, el tag
# que construye `docker compose build`; en produccion es el sha publicado en GHCR.
APP_VERSION=dev

# Environment
# Este archivo es el perfil de DESARROLLO. El de produccion es
# backend/.env.production.example.
ENV=development
COOKIE_SECURE=true
COOKIE_SAMESITE=none
EXPOSE_API_DOCS=false
RATE_LIMIT_ENABLED=true

# Mercado Pago Checkout Pro / OAuth (server-side only)
MERCADOPAGO_OAUTH_CLIENT_ID=
MERCADOPAGO_OAUTH_CLIENT_SECRET=
MERCADOPAGO_OAUTH_REDIRECT_URI=https://api.yourdomain.com/payments/mercadopago/oauth/callback
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_OAUTH_STATE_TTL_SECONDS=900
MERCADOPAGO_WEBHOOK_MAX_AGE_SECONDS=300
# Minutos que un turno retiene el slot esperando el pago de la sena
PAYMENT_HOLD_MINUTES=30
