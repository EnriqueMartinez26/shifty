# Database
POSTGRES_USER=shifty_user
POSTGRES_PASSWORD=shifty_password
POSTGRES_DB=shifty_db

# App Settings
SECRET_KEY=generate_a_very_secret_key_here_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# URLs
DATABASE_URL=postgresql+asyncpg://shifty_user:shifty_password@localhost:5432/shifty_db
REDIS_URL=redis://localhost:6379/0
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
VITE_API_URL=/api
CRON_SECRET=change_me
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Optional local worker stack. docker-compose overrides these for RabbitMQ.
RABBITMQ_DEFAULT_USER=shifty
RABBITMQ_DEFAULT_PASS=shifty_password
CELERY_BROKER_URL=amqp://shifty:shifty_password@rabbitmq:5672//
CELERY_RESULT_BACKEND_URL=redis://redis:6379/1

# Email (Mock for now)
SMTP_HOST=placeholder
SMTP_PORT=587
SMTP_USER=placeholder
SMTP_PASS=placeholder
EMAILS_FROM_EMAIL=no-reply@shifty.app

# Environment
ENV=production
RUN_RUNTIME_CONTRACTS_ON_STARTUP=false
COOKIE_SECURE=true
COOKIE_SAMESITE=none
EXPOSE_API_DOCS=false
ALLOW_PUBLIC_REGISTRATION=false
RATE_LIMIT_ENABLED=true
FIELD_ENCRYPTION_KEY=change_this_to_a_32_char_minimum_secret

# Mercado Pago Checkout Pro / OAuth (server-side only)
MERCADOPAGO_OAUTH_CLIENT_ID=
MERCADOPAGO_OAUTH_CLIENT_SECRET=
MERCADOPAGO_OAUTH_REDIRECT_URI=https://api.yourdomain.com/payments/mercadopago/oauth/callback
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_OAUTH_STATE_TTL_SECONDS=900
MERCADOPAGO_WEBHOOK_MAX_AGE_SECONDS=300
# Minutos que un turno retiene el slot esperando el pago de la sena
PAYMENT_HOLD_MINUTES=30
