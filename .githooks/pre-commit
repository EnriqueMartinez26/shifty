#!/bin/sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"

printf '\n[pre-commit] Toolchain\n'
sh "$repo_root/.githooks/verify-toolchain"

printf '\n[pre-commit] Frontend checks\n'
(
  cd "$repo_root/frontend"
  npm run check
)

printf '\n[pre-commit] Backend checks\n'
if command -v uv >/dev/null 2>&1; then
  (
    cd "$repo_root/backend"
    uv run ruff format --check .
    uv run ruff check .
    uv run mypy .
  )
else
  printf '[pre-commit] uv no esta en el PATH local; se omiten los checks de backend (corren en Docker/CI)\n'
fi

printf '\n[pre-commit] OK\n'
