{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "backend/server.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/backend/server.py"
    }
  ],
  "crons": [
    {
      "path": "/ops/internal/cron/reminders/schedule",
      "schedule": "0 3 * * *"
    }
  ]
}
