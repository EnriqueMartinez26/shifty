ENV=production
RUN_RUNTIME_CONTRACTS_ON_STARTUP=false

SECRET_KEY=replace_with_at_least_32_random_chars
FIELD_ENCRYPTION_KEY=replace_with_at_least_32_random_chars
CRON_SECRET=replace_with_at_least_32_random_chars

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
ALLOW_PUBLIC_REGISTRATION=false
COOKIE_SECURE=true
COOKIE_SAMESITE=none

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?ssl=require
REDIS_URL=rediss://default:PASSWORD@HOST:6379

FRONTEND_URL=https://app.example.com
PUBLIC_API_URL=https://api.example.com
CORS_ORIGINS=https://app.example.com

EXPOSE_API_DOCS=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_CLOSED=false
TRUST_PROXY_HEADERS=true
OPS_ENABLE_PUBLIC_HEALTH=true

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace_with_smtp_user
SMTP_PASS=replace_with_smtp_password
EMAILS_FROM_EMAIL=no-reply@example.com

CELERY_BROKER_URL=amqp://USER:PASSWORD@RABBITMQ_HOST:5672//
CELERY_RESULT_BACKEND_URL=redis://REDIS_HOST:6379/1
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_ACKS_LATE=true
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=120
CELERY_TASK_TIME_LIMIT_SECONDS=150

OTP_PROVIDER=console
OTP_DEBUG_EXPOSE_CODE=false

SENTRY_DSN=
MERCADOPAGO_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
