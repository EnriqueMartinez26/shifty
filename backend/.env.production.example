# Perfil de PRODUCCION. Se copia a la RAIZ del repo como `.env`:
#
#     cp backend/.env.production.example .env
#
# Es el archivo que docker-compose.prod.yml entrega a los tres procesos con
# `env_file: .env`, y de donde compose interpola los `${VAR:?...}` de los DOS
# composes (base y override) antes de fusionarlos. Toda variable que alguno de
# los dos exija con `:?` tiene que estar aca, o `docker compose config` aborta.
ENV=production

# Tag de las imagenes que corre el servidor (F0-02): el que CI publico en GHCR
# (ghcr.io/enriquemartinez26/shifty-{backend,frontend,nginx}). El deploy lo
# cambia para avanzar o para volver atras. Sin default: vacio, compose no levanta.
APP_VERSION=

SECRET_KEY=replace_with_at_least_32_random_chars
FIELD_ENCRYPTION_KEY=replace_with_at_least_32_random_chars
CRON_SECRET=replace_with_at_least_32_random_chars

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
COOKIE_SECURE=true
# Lax: la cookie de refresh es credencial; None la mandaba cross-site (CSRF).
COOKIE_SAMESITE=lax

# Base administrada: la URL trae `ssl=require` (parametro de asyncpg; no uses
# `sslmode=`, rompe la API). Sin `ssl`, las migraciones exigen TLS igual
# (core.config.parse_db_url, B7-11). Si en cambio se usa el `db` del
# docker-compose, el TLS lo decide POSTGRES_SSL en el .env de la raiz, y solo
# puede ser `require` si esa base tiene TLS configurado (hoy no lo tiene).
# Son DOS URLs y DOS roles distintos, a proposito:
#
#   DATABASE_URL           -> rol de la APP (shifty_app): sin superusuario y sin
#                             BYPASSRLS, para que el aislamiento por RLS lo
#                             alcance. Si aca va el rol dueno, la API se niega a
#                             arrancar.
#   MIGRATION_DATABASE_URL -> rol DUENO de la base: las migraciones necesitan
#                             DDL y CREATE EXTENSION, y crean el rol shifty_app.
#                             Si falta, alembic migra con la URL de la app y el
#                             DDL falla por permisos.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?ssl=require
MIGRATION_DATABASE_URL=postgresql+asyncpg://OWNER_USER:OWNER_PASSWORD@HOST/DBNAME?ssl=require
# Contrasena del rol DUENO del `db` del compose base (el compose la exige aunque
# la base sea administrada, porque interpola el archivo base entero). Con base
# administrada, poner la misma que OWNER_PASSWORD. Sin default a proposito
# (AUD2-C-02): `openssl rand -hex 32`.
POSTGRES_PASSWORD=
# Contrasena con la que la migracion crea el rol `shifty_app` (el USER de
# DATABASE_URL). Obligatoria: sin ella la migracion aborta. Tiene que coincidir
# con el PASSWORD de DATABASE_URL. Vacia a proposito: copiar este archivo sin
# completarla hace fallar la migracion en vez de crear el rol con un valor conocido.
APP_DB_PASSWORD=
# Dos Redis (F0-15). REDIS_URL es el de ESTADO: rate limit, idempotencia,
# lockout, OTP; sin desalojo (noeviction) y con RDB. REDIS_CACHE_URL es el del
# cache de disponibilidad: allkeys-lru, sin persistencia. Con los servicios del
# compose: redis://redis_state:6379/0 y redis://redis_cache:6379/0. NUNCA el
# mismo Redis con desalojo para los dos: expulsaria lockout e idempotencia.
REDIS_URL=rediss://default:PASSWORD@HOST:6379
REDIS_CACHE_URL=rediss://default:PASSWORD@CACHE_HOST:6379
# Tope por operacion contra Redis: con 2 s un Redis caido retenia cada request
# hasta ~24 s. Minimo aceptado: 0.1.
REDIS_SOCKET_TIMEOUT_SECONDS=0.5
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=0.5

FRONTEND_URL=https://app.example.com
PUBLIC_API_URL=https://api.example.com
CORS_ORIGINS=https://app.example.com

EXPOSE_API_DOCS=false
RATE_LIMIT_ENABLED=true
# true: si Redis cae, mejor 503 en auth que quedar sin ningun limite.
RATE_LIMIT_FAIL_CLOSED=true
# Solo con el nginx del repo delante (reescribe X-Forwarded-For). Si hay otro
# proxy/CDN, configurarlo para reescribir el header o poner esto en false.
TRUST_PROXY_HEADERS=true
OPS_ENABLE_PUBLIC_HEALTH=true

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace_with_smtp_user
SMTP_PASS=replace_with_smtp_password
EMAILS_FROM_EMAIL=no-reply@example.com

CELERY_BROKER_URL=amqp://USER:PASSWORD@RABBITMQ_HOST:5672//
# Contrasena del rabbitmq del compose base; el compose la exige igual que
# POSTGRES_PASSWORD. Con broker administrado, la misma PASSWORD de la URL de
# arriba. Sin default a proposito (AUD2-C-02): `openssl rand -hex 32`.
RABBITMQ_DEFAULT_PASS=
# Los resultados de Celery van al Redis de ESTADO (con el compose:
# redis://redis_state:6379/1).
CELERY_RESULT_BACKEND_URL=redis://REDIS_HOST:6379/1
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_ACKS_LATE=true
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=120
CELERY_TASK_TIME_LIMIT_SECONDS=150

# console esta prohibido en produccion (el arranque lo rechaza).
OTP_PROVIDER=twilio
OTP_DEBUG_EXPOSE_CODE=false

SENTRY_DSN=
MERCADOPAGO_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
